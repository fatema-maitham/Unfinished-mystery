  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4026c813db18b434d96964fb0345daf5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  label: Ask for Hint
  subLabel: Hint
  activationRadius: 1.3
  speakerName: Magical Grimoire
  hint_Start: "You wake up slumped at your desk. Something feels wrong. Look around
    \u2014 the desk holds more than it seems."
  hint_DeskDone: "The memo, the exam, the note under the mug \u2014 it all points
    to something hidden in this room. Check the bookshelf."
  hint_BookshelfDone: WHEN YOU LIE, NUMBERS REMEMBER. Count the letters in each word.
    That's your combination.
  hint_DrawerUnlocked: "The drawer is open. There's something inside \u2014 pick
    it up. It might be the key to the laptop."
  hint_USBFound: You have the drive. Plug it into the laptop on the desk.
  hint_LaptopBooted: "One file is locked. The password is a number \u2014 honest,
    mathematical. Think about what n means. The book told you. The dedication told
    you."
  hint_FileDecrypted: You have everything. The phone on the desk just lit up. It's
    time to make this right.
  hint_Complete: "The loop is broken. The evidence is out there. Whatever comes next
    \u2014 you chose honesty."
