  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1761343060}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d2e9ee25870034bd0a12ab35b59f0e38, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  bookCanvas: {fileID: 1761343060}
  bookPanel: {fileID: 335760157}
  leftImage: {fileID: 1056484770}
  leftText: {fileID: 937763601}
  rightText: {fileID: 27243365}
  turningPage: {fileID: 320284884}
  turningText: {fileID: 1043788897}
  nextButton: {fileID: 1424770053}
  closeButton: {fileID: 753942431}
  audioSource: {fileID: 1761343062}
  pageTurnSound: {fileID: 8300000, guid: 92dd874338a2c48c0a56660c696946f5, type: 3}
  spreads:
  - leftImage: {fileID: 21300000, guid: 1bd89f2b455b94127ba94e38b047f3f3, type: 3}
    leftText: 'I used to think memories protected people.

      Now I think they
      only teach us how to hide.

      Isla Thompson'
    rightText: "I found this after she disappeared.\nTwo windows.\nFive books.\nNine
      red marks around the door.\nI spent years looking at it.\nI still don\u2019t
      know how I missed it.\n"
    bigText: 0
  - leftImage: {fileID: 21300000, guid: b779aafe280de4413bed8c91bf0f12cb, type: 3}
    leftText: "Isla Thompson \u2014 Age 6\nShe smiled in every photograph.\nThat
      is the cruelest part of all this."
    rightText: 'Children remember things adults try to erase.

      The silence.

      The
      smell.

      The sound of shoes outside the door.

      The uniform.'
    bigText: 0
  - leftImage: {fileID: 0}
    leftText: 'I checked every witness statement.

      Every report.

      Every
      recording.

      His name was always missing.'
    rightText: 'He never left the scene.

      He stayed in uniform.'
    bigText: 0
  - leftImage: {fileID: 21300000, guid: 7ea040732721644f9b644b8ea9e14734, type: 3}
    leftText: 'Badge 259

      The drawing was never random.

      She was trying
      to tell us who he was.'
    rightText: 'The department called it procedural error.

      Missing evidence.

      Corrupted
      recordings.

      But none of it was accidental.'
    bigText: 0
  - leftImage: {fileID: 0}
    leftText: 'I found proof.

      And then I understood why everyone stayed quiet.

      Some
      truths destroy everything around them.'
    rightText: 'I told myself hiding the evidence would protect someone.

      Maybe
      I only wanted to protect myself.'
    bigText: 0
  - leftImage: {fileID: 0}
    leftText: "If you found this book\u2026\nThen the room already knows you\u2019re
      listening."
    rightText: 'I hid the truth because I was afraid.

      Now the room is giving
      it back.'
    bigText: 0
  openAnimationTime: 0.2
  pageTurnTime: 0.45
