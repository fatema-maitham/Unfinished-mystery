/*
    HUD.uss  (partial – ? help button styles)
    ==========================================
    Warm parchment theme — matches InstructionCarousel.uss
    Merge into your existing HUD stylesheet.
*/

.hud-top-bar {
    flex-direction: row;
    align-items: center;
    padding: 10px 16px;
    background-color: rgba(44,35,24,0.50);
}

.hud-spacer {
    flex-grow: 1;
}

.hud-right-buttons {
    flex-direction: row;
    align-items: center;
}

/* The ? circular button — tan/parchment style */
.btn-help {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: rgba(237,232,223,0.15);
    border-color: rgba(237,232,223,0.45);
    border-width: 2px;
    color: rgb(237,232,223);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-font: resource("Fonts/Cinzel-SemiBold SDF");
    -unity-text-align: middle-center;
    cursor: link;
    transition-duration: 0.15s;
    transition-property: background-color, border-color;
}

.btn-help:hover {
    background-color: rgba(237,232,223,0.28);
    border-color: rgba(237,232,223,0.80);
}

.btn-help:active {
    background-color: rgba(237,232,223,0.40);
}

.hud-label {
    color: rgb(237,232,223);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-font: resource("Fonts/HY Wenhei (zh-cn) 2 SDF");
}
