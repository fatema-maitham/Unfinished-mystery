<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UI/Instructions/InstructionCarousel.uss?fileID=7433441132597879392&amp;guid=0735dc2b933f4db4286ac938bf0d5186&amp;type=3#InstructionCarousel" />
    <ui:VisualElement name="carousel-overlay" class="carousel-overlay">
        <ui:VisualElement name="carousel-panel" class="carousel-panel">
            <ui:Button name="btn-close" text="✕" class="btn-close" />
            <ui:VisualElement name="slide-image" class="slide-image" />
            <ui:Label name="slide-title" text="Slide Title" class="slide-title" />
            <ui:Label name="slide-desc" text="Description goes here." class="slide-desc" />
            <ui:VisualElement class="carousel-controls">
                <ui:Button name="btn-prev" text="‹" class="arrow-btn" />
                <ui:VisualElement class="dots-row">
                    <ui:VisualElement name="dots-container" class="dots-container" />
                    <ui:Label name="slide-counter" text="1 / 5" class="slide-counter" />
                </ui:VisualElement>
                <ui:Button name="btn-next" text="›" class="arrow-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
