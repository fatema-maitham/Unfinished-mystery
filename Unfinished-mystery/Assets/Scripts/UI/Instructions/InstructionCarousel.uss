/*
    InstructionCarousel.uss
    =======================
    Warm parchment / linen theme — matches the Kyryll Flins character-card reference.
    Fonts: Cinzel (titles/headers)  ·  HY Wenhei (body/description)
*/

/* ── Tokens ─────────────────────────────────────────────────────────────── */
:root {
    /* Parchment palette */
    --bg-overlay:       rgba(44,35,24,0.68);       /* warm dim backdrop        */
    --panel-bg:         rgb(237,232,223);           /* #EDE8DF linen card       */
    --panel-border:     rgb(196,186,170);           /* #C4BAAA subtle edge      */
    --mission-box-bg:   rgb(212,207,198);           /* #D4CFC6 inset box        */
    --mission-box-border: rgb(180,170,155);

    /* Text */
    --title-color:      rgb(44,35,24);              /* #2C2318 deep brown       */
    --subtitle-color:   rgb(100,82,62);             /* #64523E medium brown     */
    --mission-label:    rgb(44,35,24);              /* bold label inside box    */
    --desc-color:       rgb(80,65,50);              /* #504132 body text        */
    --quote-color:      rgb(50,40,30);              /* slightly darker quote    */
    --counter-color:    rgb(140,120,95);            /* #8C785F muted tan        */

    /* Interactive */
    --dot-inactive:     rgb(180,168,150);
    --dot-active:       rgb(80,65,50);
    --arrow-color:      rgb(80,65,50);
    --arrow-hover-bg:   rgba(44,35,24,0.10);
    --close-hover-bg:   rgba(160,60,40,0.18);
}

/* ── Full-screen overlay ─────────────────────────────────────────────────── */
.carousel-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: var(--bg-overlay);
    align-items: center;
    justify-content: center;
}

.carousel-overlay.hidden {
    display: none;
}

/* ── Card panel ──────────────────────────────────────────────────────────── */
.carousel-panel {
    width: 700px;
    background-color: var(--panel-bg);
    border-color: var(--panel-border);
    border-width: 1px;
    border-radius: 6px;
    padding: 36px 40px 30px 40px;
    align-items: center;
}

/* ── Close button ────────────────────────────────────────────────────────── */
.btn-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: rgba(44,35,24,0.06);
    border-color: var(--panel-border);
    border-width: 1px;
    color: var(--subtitle-color);
    font-size: 16px;
    -unity-font-style: bold;
    cursor: link;
    transition-duration: 0.15s;
    transition-property: background-color;
}

.btn-close:hover {
    background-color: var(--close-hover-bg);
}

/* ── Illustration area ───────────────────────────────────────────────────── */
.slide-image {
    width: 100%;
    height: 260px;
    border-radius: 4px;
    background-color: rgb(212,207,198);
    margin-bottom: 22px;
    -unity-background-scale-mode: scale-to-fit;
    overflow: hidden;
}

/* ── Slide title (Cinzel) ────────────────────────────────────────────────── */
.slide-title {
    color: var(--title-color);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font: resource("Fonts/Cinzel-SemiBold SDF");
    white-space: normal;
    margin-bottom: 6px;
    letter-spacing: 2px;
}

/* ── Mission / instruction label box ────────────────────────────────────── */
.mission-box {
    width: 100%;
    background-color: var(--mission-box-bg);
    border-color: var(--mission-box-border);
    border-width: 1px;
    border-radius: 3px;
    padding: 14px 18px;
    margin-bottom: 18px;
}

.mission-label {
    color: var(--mission-label);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-font: resource("Fonts/Cinzel-SemiBold SDF");
    letter-spacing: 1px;
    margin-bottom: 8px;
}

/* ── Description / quote (HY Wenhei) ────────────────────────────────────── */
.slide-desc {
    color: var(--desc-color);
    font-size: 14px;
    -unity-font-style: normal;
    -unity-font: resource("Fonts/HY Wenhei (zh-cn) 2 SDF");
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 24px;
    max-width: 540px;
}

/* ── Controls row (prev | dots | next) ──────────────────────────────────── */
.carousel-controls {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
}

/* ── Arrow buttons ───────────────────────────────────────────────────────── */
.arrow-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: transparent;
    border-color: var(--panel-border);
    border-width: 1px;
    color: var(--arrow-color);
    font-size: 26px;
    -unity-text-align: middle-center;
    cursor: link;
    transition-duration: 0.15s;
    transition-property: background-color, opacity;
}

.arrow-btn:hover {
    background-color: var(--arrow-hover-bg);
}

.arrow-btn:active {
    background-color: rgba(44,35,24,0.16);
}

.arrow-disabled {
    opacity: 0.25;
    cursor: arrow;
}

/* ── Dots row ────────────────────────────────────────────────────────────── */
.dots-row {
    align-items: center;
    flex-direction: column;
    flex-grow: 1;
}

.dots-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
}

.dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--dot-inactive);
    margin-left: 5px;
    margin-right: 5px;
    transition-duration: 0.2s;
    transition-property: background-color, width;
}

.dot-active {
    background-color: var(--dot-active);
    width: 20px;
    border-radius: 4px;
}

/* ── Slide counter (1 / 5) ───────────────────────────────────────────────── */
.slide-counter {
    color: var(--counter-color);
    font-size: 12px;
    -unity-font: resource("Fonts/HY Wenhei (zh-cn) 2 SDF");
    -unity-text-align: middle-center;
}
